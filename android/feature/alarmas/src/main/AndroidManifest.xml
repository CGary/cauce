<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SPEC §5: a dose cannot drift 15 minutes for battery saving.
         Android 12-12L need the user-granted permission; 13+ use the alarm-clock one. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 13+: asked at runtime from the alarm list screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full screen over the lock screen while the phone rings (2.3). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Foreground service that plays the alarm (USAGE_ALARM), type systemExempted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- The CPU stays awake while the alarm rings. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Alarms survive reboots (2.7). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <activity
            android:name=".device.AlarmAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".device.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".device.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".device.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
