# cauce server — configuration
#
# Copy to .env (gitignored) and fill in the values. Docker Compose (`make up`)
# loads this file.
#
# Under Compose, compose.yaml forces CAUCE_ADDR to ":8080" and CAUCE_DB_PATH to
# "/data/cauce.db", so the two values below only apply when running the binary
# directly (make server-run).

# Listen address. Behind Cloudflare Tunnel this stays on localhost.
CAUCE_ADDR=:8080

# SQLite database path. The directory is created on startup.
CAUCE_DB_PATH=data/cauce.db

# The single user id. Every request is attributed to it; Cloudflare Access is
# the real gate and the server trusts the network.
CAUCE_USER_ID=u1

# Origen exacto de la consola web para CORS (vacío = CORS desactivado).
CAUCE_CORS_ORIGIN=

# Cloudflare R2 (S3-compatible) for blob uploads. Without all four variables
# POST /blobs/presign returns 503; the rest of the server works normally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cauce
# Optional Cloudflare Tunnel token. Start the tunnel with: make tunnel
# TUNNEL_TOKEN=
